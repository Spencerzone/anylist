rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users — any authenticated user can read profiles (needed for member lookup)
    match /users/{userId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // List definitions — access controlled by members array
    match /listDefs/{listId} {
      // Read: must be a member
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.members;

      // Create: any signed-in user; must set themselves as owner and sole member
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.members == [request.auth.uid];

      // Update:
      // (1) Any member can rename (name/emoji only, members unchanged)
      // (2) Owner can change members array
      // (3) Any auth user can add only themselves (invite accept)
      allow update: if request.auth != null && (
                      // Rename by any member
                      (request.auth.uid in resource.data.members
                       && request.resource.data.members == resource.data.members)
                      // Member management by owner
                      || (request.auth.uid == resource.data.ownerUid
                          && request.auth.uid in resource.data.members)
                      // Self-join via invite: adding only yourself
                      || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
                          && request.resource.data.members.hasAll(resource.data.members)
                          && request.resource.data.members.size() == resource.data.members.size() + 1
                          && request.auth.uid in request.resource.data.members)
                    );

      // Delete: owner only
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.ownerUid;
    }

    // List items — members only (via listDefs lookup)
    match /lists/{listId}/items/{itemId} {
      allow read, write: if request.auth != null
                         && request.auth.uid in get(/databases/$(database)/documents/listDefs/$(listId)).data.members;
    }

    // List history — members only
    match /lists/{listId}/history/{histId} {
      allow read, write: if request.auth != null
                         && request.auth.uid in get(/databases/$(database)/documents/listDefs/$(listId)).data.members;
    }

    // Lists document (learnedCategories etc.) — members only
    match /lists/{listId} {
      allow read, write: if request.auth != null
                         && request.auth.uid in get(/databases/$(database)/documents/listDefs/$(listId)).data.members;
    }

    // Invite codes — any auth user can read; only list owner can create/delete
    match /invites/{code} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid;
      allow update: if false;
    }

    // Shared recipes — any signed-in user
    match /recipes/{recipeId} {
      allow read, write: if request.auth != null;
    }

    // Shared meal plan — any signed-in user
    match /mealplan/{mealId} {
      allow read, write: if request.auth != null;
    }

  }
}
